{
  "$schema": "https://schema.tauri.app/config/2.0/schema.json",
  "productName": "Save-Edit Tool CN",
  "version": "0.9.8",
  "identifier": "com.yuemengqianlong.saveedittoolcn",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Save-Edit Tool 中文版",
        "width": 1210,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "data:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'"
        ],
        "font-src": [
          "'self'",
          "asset:"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "locales/": "locales/",
      "resources/plugins/": "resources/plugins/"
    },
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/yuemengqianlong-gif/Save-Edit-Tool-cn/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCREQzRjhBQkNFNTE1NDEKUldSQkZlVzhpai9kVzBXM2ZhNmRpUnRqcjA1anVRWHRFRXJQeGpkbnBnNUg4VGJJTmNnd2NHQVIK",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
